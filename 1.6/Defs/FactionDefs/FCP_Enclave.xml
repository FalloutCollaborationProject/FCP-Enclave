<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Factions __________-->

    <!-- Enclave -->

    <FactionDef ParentName="FactionBase">
        <defName>FCP_Faction_Enclave</defName>
        <label>The Enclave</label>
        <description>Ruthless remnants of the old world government, the Enclave believe themselves to be humanity’s rightful rulers. Isolated, technologically advanced, and fiercely nationalistic, they seek to restore civilization under their iron-fisted vision—no matter the cost to outsiders.</description>
        <colorSpectrum>
            <li>(1, 1, 1)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <pawnSingular>Constituent</pawnSingular>
        <pawnsPlural>Constituents</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.05</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>President</leaderTitle>
        <fixedLeaderKinds>
            <li>FCP_Unique_Pawnkind_President_Richardson</li>
        </fixedLeaderKinds>
        <factionIconPath>World_Icon/Enclave_Icon/FCP_Enclave_World_Icon</factionIconPath>
        <techLevel>Industrial</techLevel>
        <fixedName>The Enclave</fixedName>
        <settlementNameMaker>FCP_Namer_Settlement_Enclave</settlementNameMaker>
        <allowedCultures>
            <li>FCP_Culture_Enclave</li>
        </allowedCultures>

        <!--__________ Ideology __________-->

        <fixedIdeo>true</fixedIdeo>
        <ideoName>Manifest Destiny</ideoName>
        <ideoDescription>The Enclave represents the continuation of the United States government, destined to reclaim and restore America. Only pure, untainted humans have the right to rebuild civilization. All others are aberrations to be removed or subjugated.</ideoDescription>
        <styles>
            <li>FCP_Style_Enclave</li>
        </styles>
        <forcedMemes>
            <!-- Structure -->
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <!-- Memes -->
            <li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_EnclaveManifestDestiny</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <!--__________ Royalty __________-->

        <royalTitleTags>
            <li>FCP_Title_Enclave</li>
        </royalTitleTags>
        <royalFavorLabel>authority</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
        <royalTitleInheritanceRelations>
            <li>Child</li>
            <li>Spouse</li>
        </royalTitleInheritanceRelations>

        <!--__________ Biotech __________-->

        <xenotypeSet>
            <xenotypeChances>
                <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
                <Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
                <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
                <Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
                <Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
                <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
                <Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
            </xenotypeChances>
        </xenotypeSet>

        <!--__________ Backstories __________-->

        <backstoryFilters>
            <li>
                <categories>
                    <li>FCP_Backstory_Enclave</li>
                    <li>FCP_Backstory_Enclave_Trooper</li>
                    <li>FCP_Backstory_Enclave_Worker</li>
                    <li>FCP_Backstory_Enclave_Leader</li>
                    <li>FCP_Backstory_Enclave_Child</li>
                </categories>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>

        <!--__________ Kinds __________-->

        <!-- Base Trader Kinds -->

        <!-- Trader Kind Arrival Options -->

        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <raidLootMaker>FCP_EnclaveRaidLootMaker</raidLootMaker>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <!--__________ Group Makers __________-->

        <pawnGroupMakers>

            <!-- Enclave Trooper Squad -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Pawnkind_Enclave_Trooper>10</FCP_Pawnkind_Enclave_Trooper>
                    <FCP_Pawnkind_Enclave_Armored_Trooper>8</FCP_Pawnkind_Enclave_Armored_Trooper>
                    <FCP_Pawnkind_Eyebot_Improved MayRequire="Rick.FCP.Robotics">2</FCP_Pawnkind_Eyebot_Improved>
                    <FCP_Pawnkind_SentryBot_Minigun MayRequire="Rick.FCP.Robotics">3</FCP_Pawnkind_SentryBot_Minigun>
                </options>
                <characterDefs>
                    <li>FCP_Character_Enclave_Sergeant_Dornan</li>
                </characterDefs>
                <characterChance>0.15</characterChance>
            </li>

            <!-- Enclave X-01/APA Squad -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Pawnkind_Enclave_Power_Armor_Trooper>10</FCP_Pawnkind_Enclave_Power_Armor_Trooper>
                </options>
                <characterDefs>
                    <li>FCP_Character_Enclave_Captain_Moreau</li>
                </characterDefs>
                <characterChance>0.15</characterChance>
            </li>

            <!-- Enclave X-02, Tesla, Hellfire Squad -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper>10</FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper>
                    <FCP_Pawnkind_Enclave_MKII_Tesla_Power_Armor_Trooper>5</FCP_Pawnkind_Enclave_MKII_Tesla_Power_Armor_Trooper>
                    <FCP_Pawnkind_Enclave_Hellfire_Power_Armor_Trooper>3</FCP_Pawnkind_Enclave_Hellfire_Power_Armor_Trooper>
                    <FCP_Pawnkind_Enclave_Armored_Trooper>2</FCP_Pawnkind_Enclave_Armored_Trooper>
                    <FCP_Pawnkind_SentryBot_Rocket MayRequire="Rick.FCP.Robotics">2</FCP_Pawnkind_SentryBot_Rocket>
                    <FCP_Pawnkind_Mr_Gutsy MayRequire="Rick.FCP.Robotics">2</FCP_Pawnkind_Mr_Gutsy>
                </options>
                <characterDefs>
                    <li>FCP_Character_Enclave_President_Richardson</li>
                    <li>FCP_Character_Enclave_Lt_Col_Vickers</li>
                    <li>FCP_Character_Enclave_Major_Manderly</li>
                </characterDefs>
                <characterChance>0.20</characterChance>
            </li>

            <!-- Enclave Peaceful -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <kindDef>Peaceful</kindDef>
                <options>
                    <FCP_Pawnkind_Enclave_Trooper>14</FCP_Pawnkind_Enclave_Trooper>
                    <FCP_Pawnkind_Enclave_Power_Armor_Trooper>10</FCP_Pawnkind_Enclave_Power_Armor_Trooper>
                    <FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper>5</FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper>
                    <FCP_Pawnkind_Enclave_Armored_Trooper>2</FCP_Pawnkind_Enclave_Armored_Trooper>
                    <FCP_Pawnkind_Eyebot_Improved MayRequire="Rick.FCP.Robotics">3</FCP_Pawnkind_Eyebot_Improved>
                    <FCP_Pawnkind_Mr_Gutsy MayRequire="Rick.FCP.Robotics">2</FCP_Pawnkind_Mr_Gutsy>
                </options>
                <characterDefs>
                    <li>FCP_Character_Enclave_Dr_Curling</li>
                    <li>FCP_Character_Enclave_Dr_Holt</li>
                    <li>FCP_Character_Enclave_Whitley</li>
                </characterDefs>
                <characterChance>0.20</characterChance>
            </li>

            <!--__________ Enclave Traders __________-->

            <!-- Pre-War Goods Trader -->

            <!-- <li Class="FCP.Core.GroupMakerWithTraderKind">
                <kindDef>Trader</kindDef>
                <traderKinds>
                    <li>FCP_Caravan_Pre_War_Goods_Trader</li>
                </traderKinds>
                <traders>
                    <FCP_Enclave_Crimson_Caravan_Trader>1</FCP_Enclave_Crimson_Caravan_Trader>
                </traders>
                <carriers>
                    <FCP_Animal_Brahmin>2</FCP_Animal_Brahmin>
                </carriers>
                <guards>
                    <FCP_Armored_Wastelander_Combat_Armor>5</FCP_Armored_Wastelander_Combat_Armor>
                </guards>
            </li> -->

            <!-- Enclave Settlement -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <kindDef>Settlement</kindDef>
                <options>
                    <FCP_Pawnkind_Enclave_Armored_Trooper>10</FCP_Pawnkind_Enclave_Armored_Trooper>
                    <FCP_Pawnkind_Enclave_Trooper>14</FCP_Pawnkind_Enclave_Trooper>
                    <FCP_Pawnkind_Enclave_Power_Armor_Trooper>10</FCP_Pawnkind_Enclave_Power_Armor_Trooper>
                    <FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper>5</FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper>
                    <FCP_Pawnkind_Eyebot_Improved MayRequire="Rick.FCP.Robotics">3</FCP_Pawnkind_Eyebot_Improved>
                    <FCP_Pawnkind_Mr_Gutsy MayRequire="Rick.FCP.Robotics">2</FCP_Pawnkind_Mr_Gutsy>
                    <FCP_Pawnkind_SentryBot_Minigun MayRequire="Rick.FCP.Robotics">2</FCP_Pawnkind_SentryBot_Minigun>
                </options>
                <characterDefs>
                    <li>FCP_Character_Enclave_Dr_Curling</li>
                    <li>FCP_Character_Enclave_Dr_Holt</li>
                    <li>FCP_Character_Enclave_Whitley</li>
                </characterDefs>
                <characterChance>0.20</characterChance>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <modExtensions Inherit="False">
            <!-- Faction tab label override -->
            <li Class="FCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>U.S. Shadow Government</newLabel>
            </li>
            <!-- Make them hostile to Wastelanders -->
            <li Class="FCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li MayRequire="Rick.FCP.Wastelanders">FCP_Faction_Wasteland_Settlers</li>
                    <li MayRequire="Rick.FCP.BOS">FCP_Faction_BoS_Lost_Hills</li>
                    <li MayRequire="Rick.FCP.BOS">FCP_Faction_BoS_Midwest</li>
                    <li MayRequire="Rick.FCP.BOS">FCP_Faction_BoS_Lyons_Pride_Remnants</li>
                    <li MayRequire="Rick.FCP.BOS">FCP_Faction_BoS_Outcast_Remnants</li>
                    <li MayRequire="Rick.FCP.BOS">FCP_Faction_BoS</li>
                </hostileFactionDefs>
            </li>
            <!-- Shuttles -->
            <li Class="FCP.Core.Shuttles.FactionModExtension">
                <transportShipDef>FCP_Enclave_Vertibird</transportShipDef>
                <minDistanceBetweenShuttles>10</minDistanceBetweenShuttles>
                <maxPawnCountInOneShuttle>6</maxPawnCountInOneShuttle>
            </li>
            <li Class="FCP.Core.RadiantQuests.FactionExtension_Vertibird">
                <crashedVertibird>FCP_Enclave_Vertibird_Crashed</crashedVertibird>
                <survivorGroups>
                    <li>
                        <leaderKind>FCP_Pawnkind_Enclave_Officer</leaderKind>
                        <basicKind>FCP_Pawnkind_Enclave_Trooper</basicKind>
                        <count>8</count>
                        <difficultyMultiplier>1.0</difficultyMultiplier>
                    </li>
                    <li>
                        <basicKind>FCP_Pawnkind_Enclave_Armored_Trooper</basicKind>
                        <count>8</count>
                        <difficultyMultiplier>1.0</difficultyMultiplier>
                    </li>
                    <li>
                        <basicKind>FCP_Pawnkind_Enclave_Power_Armor_Trooper</basicKind>
                        <count>3</count>
                        <difficultyMultiplier>1.3</difficultyMultiplier>
                    </li>
                    <li>
                        <leaderKind>FCP_Pawnkind_Enclave_Officer</leaderKind>
                        <basicKind>FCP_Pawnkind_Enclave_MKII_Power_Armor_Trooper</basicKind>
                        <count>8</count>
                        <difficultyMultiplier>1.5</difficultyMultiplier>
                    </li>
                    <li>
                        <basicKind>FCP_Pawnkind_Enclave_Hellfire_Power_Armor_Trooper</basicKind>
                        <count>4</count>
                        <difficultyMultiplier>2.0</difficultyMultiplier>
                    </li>
                </survivorGroups>
            </li>
            <!-- Make them unable to use drop pods -->
            <li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <!-- Ideology stuff -->
            <li Class="FCP.Factions.FactionExtension_FixedIdeo">
                <ideoIconDef>FCP_Icon_Enclave</ideoIconDef>
                <ideoColorDef>LightGrey</ideoColorDef>
                <memberName>Constituent</memberName>
                <adjective>Manifest Destiny</adjective>
                <roleOverrides>
                    <li>
                        <preceptDef>IdeoRole_Leader</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>FCP_Precept_Role_EnclaveOfficer</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>FCP_IdeoRole_Enclave_Officer</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                </roleOverrides>
            </li>
            <!-- Enlistment stuff -->
            <li Class="FCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>FCP_Enlistment_Enclave</li>
                </enlistOptionsDefs>
                <ignoreAutoAssignedDefs>true</ignoreAutoAssignedDefs>
            </li>
            <!-- Rank track -->
            <li Class="FCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>FCP_RankTrack_Enclave</li>
                </rankTracks>
            </li>
            <!-- Make them unable to use drop pods -->
            <li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <!-- Clusters and biome configuration -->
            <li Class="FCP.Factions.FactionExtension_SettlementControl">
                <maxSettlements>4</maxSettlements>
                <allowedBiomes>
                    <li>TemperateForest</li>
                    <li>BorealForest</li>
                    <li>TemperateSwamp</li>
                </allowedBiomes>
                <clustered>true</clustered>
                <clusterRadius>30</clusterRadius>
                <namedSettlements>
                    <!-- Oil Rig -->
                    <li>
                        <name>Oil Rig</name>
                        <oceanPlacement>true</oceanPlacement>
                        <prefab>FCP_Prefab_OilRig</prefab>
                        <forcedMapSize>(150,150,0)</forcedMapSize>
                        <guaranteedCharacters>
                            <li>FCP_Character_Enclave_President_Richardson</li>
                            <li>FCP_Character_Enclave_Sergeant_Dornan</li>
                        </guaranteedCharacters>
                        <traders>
                            <li>
                                <traderName>Dornan's Armory</traderName>
                                <traderKind>FCP_Trader_OilRig_DornansArmory</traderKind>
                            </li>
                            <li>
                                <traderName>Richardson's Reserve</traderName>
                                <traderKind>FCP_Trader_OilRig_RichardsonsReserve</traderKind>
                            </li>
                        </traders>
                    </li>
                    <!-- Raven Rock -->
                    <li>
                        <name>Raven Rock</name>
                        <guaranteedCharacters>
                            <li>FCP_Character_Enclave_Colonel_Autumn</li>
                            <li>FCP_Character_Enclave_Lt_Col_Vickers</li>
                            <li>FCP_Character_Enclave_Dr_Curling</li>
                        </guaranteedCharacters>
                        <traders>
                            <li>
                                <traderName>Autumn's Armory</traderName>
                                <traderKind>FCP_Trader_RavenRock_AutumnsArmory</traderKind>
                            </li>
                            <li>
                                <traderName>Vickers' Hellfire Depot</traderName>
                                <traderKind>FCP_Trader_RavenRock_VickersHellfireDepot</traderKind>
                            </li>
                            <li>
                                <traderName>Curling's Laboratory</traderName>
                                <traderKind>FCP_Trader_RavenRock_CurlingsLaboratory</traderKind>
                            </li>
                        </traders>
                    </li>
                    <!-- Navarro -->
                    <li>
                        <name>Navarro</name>
                        <guaranteedCharacters>
                            <li>FCP_Character_Enclave_Major_Manderly</li>
                            <li>FCP_Character_Enclave_Captain_Moreau</li>
                        </guaranteedCharacters>
                        <traders>
                            <li>
                                <traderName>Manderly's Armory</traderName>
                                <traderKind>FCP_Trader_Navarro_ManderlysArmory</traderKind>
                            </li>
                            <li>
                                <traderName>Moreau's Hangar</traderName>
                                <traderKind>FCP_Trader_Navarro_MoreausHangar</traderKind>
                            </li>
                        </traders>
                    </li>
                    <!-- Adams Air Force Base -->
                    <li>
                        <name>Adams Air Force Base</name>
                        <guaranteedCharacters>
                            <li>FCP_Character_Enclave_Whitley</li>
                            <li>FCP_Character_Enclave_Dr_Holt</li>
                        </guaranteedCharacters>
                        <traders>
                            <li>
                                <traderName>Whitley's Hellfire Works</traderName>
                                <traderKind>FCP_Trader_AdamsAFB_WhitleysHellfireWorks</traderKind>
                            </li>
                            <li>
                                <traderName>Holt's Field Lab</traderName>
                                <traderKind>FCP_Trader_AdamsAFB_HoltsFieldLab</traderKind>
                            </li>
                        </traders>
                    </li>
                </namedSettlements>
            </li>
        </modExtensions>
    </FactionDef>

    <ThingSetMakerDef>
        <defName>FCP_EnclaveRaidLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                        <li>MedicineIndustrial</li>
                        <li>ComponentIndustrial</li>
                        <li>MealSurvivalPack</li>
                        <li>Neutroamine</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>

</Defs>
