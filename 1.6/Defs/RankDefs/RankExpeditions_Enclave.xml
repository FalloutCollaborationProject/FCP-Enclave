<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Enclave Rank Expeditions __________-->

    <!-- Loot -->

    <ThingSetMakerDef>
        <defName>FCP_EnclaveExpeditionLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>FCP_Currency_Enclave_Platinum_Bullion</li>
                        <li>Steel</li>
                        <li>ComponentIndustrial</li>
                        <li>MedicineIndustrial</li>
                        <li>Neutroamine</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>

    <!-- Novice -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Enclave_Novice</defName>
        <label>reconnaissance sweep</label>
        <description>A short patrol beyond the perimeter to chart hostile movement and confirm the wasteland hasn't gotten any closer.</description>
        <durationDays>3~5</durationDays>
        <xpReward>
            <Shooting>200</Shooting>
        </xpReward>
        <lootMaker>FCP_EnclaveExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>50~150</lootMarketValueRange>
        <siteRevealChance>0.15</siteRevealChance>
        <failureChance>0.12</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Enclave_Novice_1</li>
            <li>FCP_Rank_Expedition_Enclave_Novice_2</li>
            <li>FCP_Rank_Expedition_Enclave_Novice_3</li>
            <li>FCP_Rank_Expedition_Enclave_Novice_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Veteran -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Enclave_Veteran</defName>
        <label>containment operation</label>
        <description>A tasked strike against a mutant nest or wasteland holdout, run with the discipline the Enclave expects of its own.</description>
        <durationDays>6~8</durationDays>
        <xpReward>
            <Shooting>400</Shooting>
            <Intellectual>100</Intellectual>
        </xpReward>
        <lootMaker>FCP_EnclaveExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>150~350</lootMarketValueRange>
        <siteRevealChance>0.25</siteRevealChance>
        <failureChance>0.1</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Enclave_Veteran_1</li>
            <li>FCP_Rank_Expedition_Enclave_Veteran_2</li>
            <li>FCP_Rank_Expedition_Enclave_Veteran_3</li>
            <li>FCP_Rank_Expedition_Enclave_Veteran_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Elite -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Enclave_Elite</defName>
        <label>deep wasteland incursion</label>
        <description>A solo operation into territory no patrol has mapped, the kind of mission only a decorated officer or senior researcher is trusted to run alone.</description>
        <durationDays>8~10</durationDays>
        <xpReward>
            <Shooting>600</Shooting>
            <Intellectual>150</Intellectual>
        </xpReward>
        <lootMaker>FCP_EnclaveExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>300~600</lootMarketValueRange>
        <siteRevealChance>0.35</siteRevealChance>
        <failureChance>0.08</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Enclave_Elite_1</li>
            <li>FCP_Rank_Expedition_Enclave_Elite_2</li>
            <li>FCP_Rank_Expedition_Enclave_Elite_3</li>
            <li>FCP_Rank_Expedition_Enclave_Elite_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

    <!-- Sentinel -->

    <FCP.Ranks.RankExpeditionDef>
        <defName>FCP_Expedition_Enclave_Sentinel</defName>
        <label>continental directive</label>
        <description>A long-range campaign carried out under direct Presidential orders, the kind of mission that decides whether a region falls under Enclave control or gets written off.</description>
        <durationDays>10~14</durationDays>
        <xpReward>
            <Shooting>800</Shooting>
            <Intellectual>200</Intellectual>
        </xpReward>
        <lootMaker>FCP_EnclaveExpeditionLootMaker</lootMaker>
        <lootMarketValueRange>500~900</lootMarketValueRange>
        <siteRevealChance>0.5</siteRevealChance>
        <failureChance>0.05</failureChance>
        <returnFlavorKeys>
            <li>FCP_Rank_Expedition_Enclave_Sentinel_1</li>
            <li>FCP_Rank_Expedition_Enclave_Sentinel_2</li>
            <li>FCP_Rank_Expedition_Enclave_Sentinel_3</li>
            <li>FCP_Rank_Expedition_Enclave_Sentinel_4</li>
        </returnFlavorKeys>
    </FCP.Ranks.RankExpeditionDef>

</Defs>
