<Defs>


    <!--__________ Pawnkinds __________-->

    <!--_____ Enclave Pawnkinds _____-->

    <!-- Enclave Pawnkind base -->
    
    <PawnKindDef Name="FCP_EnclavekindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>FCP_Faction_Enclave</defaultFactionDef>
        <maxGenerationAge>60</maxGenerationAge>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>MealSurvivalPack</invFoodDef>
        <weaponTags>
			<li>FCP_Enclave_Weapon</li>
            <li MayRequire="Rick.FCP.EnergyWeapons">FCP_Plasma_Weapon</li>
        </weaponTags>
        <disallowedTraits>
            <li>Nudist</li>
            <li>Brawler</li>
        </disallowedTraits>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <apparelDisallowTags>
            <li>FCP_Power_Armor</li>
            <li>FCP_Power_Armor_Midwest</li>
            <li>FCP_Power_Armor_BoS</li>
            <li>FCP_Power_Armor_NCR</li>
            <li>FCP_Power_Armor_Legion</li>
            <li>IndustrialBasic</li>
            <li>IndustrialAdvanced</li>
            <li>IndustrialMilitary</li>
            <li>SpacerMilitary</li>
        </apparelDisallowTags>
        <apparelTags>
            <li>FCP_Enclave_Apparel</li>
        </apparelTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Enclave_Child</li>
                </categoriesChildhood>
            </li>
        </backstoryFiltersOverride>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
    </PawnKindDef>

    <!--___ Officers ___-->
    
    <PawnKindDef ParentName="FCP_EnclavekindBase">
        <defName>FCP_Pawnkind_Enclave_Officer</defName>
        <label>Enclave Officer</label>
        <combatPower>110</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.5~1.8</gearHealthRange>
        <apparelMoney>9999</apparelMoney>
        <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
        <apparelRequired>
            <li>FCP_Apparel_Enclave_Trooper_Uniform</li>
            <li>FCP_Apparel_Enclave_Officer_Coat</li>
            <li>FCP_Apparel_Enclave_Officer_Cap</li>
        </apparelRequired>
        <weaponMoney>9999</weaponMoney>
        <weaponTags>
            <li MayRequire="Rick.FCP.EnergyWeapons">FCP_Plasma_Weapon</li>
            <li MayRequire="Rick.FCP.COA">FCP_Gamma_Gun</li>
            <li MayRequire="Rick.FCP.COA">FCP_Radium_Rifle</li>
        </weaponTags>
        <disallowedTraits>
            <li>Brawler</li>
        </disallowedTraits>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <techHediffsMoney>0</techHediffsMoney>
        <techHediffsTags>
            <li>Poor</li>
        </techHediffsTags>
        <techHediffsChance>0</techHediffsChance>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>15~24</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Enclave_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Enclave_Trooper</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <inventoryOptions>
            <skipChance>0.0</skipChance>
            <subOptionsChooseOne>
                <li MayRequire="Rick.FCP.Chems">
                    <thingDef>FCP_Chem_Stimpak</thingDef>
                    <countRange>2~3</countRange>
                </li>
                <li MayRequire="Rick.FCP.Chems">
                    <thingDef>FCP_Chem_MedX</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li MayRequire="Rick.FCP.PreWarFood">
                    <thingDef>FCP_Food_Cram</thingDef>
                    <countRange>2~4</countRange>
                </li>
                <li MayRequire="Rick.FCP.PreWarFood">
                    <thingDef>FCP_Food_Sugar_Bombs</thingDef>
                    <countRange>1~3</countRange>
                </li>
                <li MayRequire="Rick.FCP.NukaCola">
                    <thingDef>FCP_Nuka_Cola</thingDef>
                    <countRange>1~2</countRange>
                </li>
            </subOptionsChooseOne>
        </inventoryOptions>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
    </PawnKindDef>

