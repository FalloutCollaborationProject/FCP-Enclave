<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <!--__________ Enclave Memes __________-->

    <MemeDef>
        <defName>FCP_Meme_EnclaveManifestDestiny</defName>
        <label>Enclave Manifest Destiny</label>
        <description>The Enclave represents the continuation of the United States government, destined to reclaim and restore America. Only pure, untainted humans have the right to rebuild civilization. All others are aberrations to be removed or subjugated.</description>
        <iconPath>Things/UI/Ideology/FCP_Enclave_Manifest Destiny</iconPath>
        <groupDef>Misc</groupDef>
        <impact>2</impact>
        <randomizationSelectionWeightFactor>0</randomizationSelectionWeightFactor>
        <hiddenInChooseMemes>true</hiddenInChooseMemes>
        <requireOne>
            <li>
                <li>FCP_Precept_Role_EnclaveOfficer</li>
            </li>
        </requireOne>
    </MemeDef>

    <!--__________ Roles __________-->

    <PreceptDef ParentName="PreceptRoleSingleBase">
        <defName>FCP_Precept_Role_EnclaveOfficer</defName>
        <label>Enclave Officer</label>
        <description>An elite officer of the Enclave, trained in leadership and advanced combat tactics. They excel at research, combat, and maintaining discipline.</description>
        <iconPath>Things/UI/Roles/FCP_Enclave_Officer</iconPath>
        <nameMaker>FCP_RoleNameMaker_EnclaveOfficer</nameMaker>
        <impact>High</impact>
        <displayOrderInImpact>100</displayOrderInImpact>
        <conflictingMemes>
            <li>Individualist</li>
        </conflictingMemes>
        <requiredMemes>
            <li>FCP_Meme_EnclaveManifestDestiny</li>
        </requiredMemes>
        <roleRequiredWorkTags>
            <li>Intellectual</li>
            <li>Social</li>
        </roleRequiredWorkTags>
        <roleEffects>
            <li Class="RoleEffect_PawnStatFactor">
                <statDef>ResearchSpeed</statDef>
                <modifier>1.25</modifier>
            </li>
            <li Class="RoleEffect_PawnStatFactor">
                <statDef>ShootingAccuracyPawn</statDef>
                <modifier>1.15</modifier>
            </li>
            <li Class="RoleEffect_PawnStatFactor">
                <statDef>SocialImpact</statDef>
                <modifier>1.20</modifier>
            </li>
        </roleEffects>
        <roleApparelRequirements>
            <li>
                <requirement>
                    <bodyPartGroupsMatchAny>
                        <li>UpperHead</li>
                        <li>FullHead</li>
                    </bodyPartGroupsMatchAny>
                    <requiredDefs>
                        <li>FCP_Apparel_Enclave_Officer_Cap</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_Advanced_Power_Armor_Helmet</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_Advanced_Power_Armor_MkII_Helmet</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_X02_Tesla_Power_Armor_Helmet</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_X02_Power_Armor_Helmet</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_Hellfire_Power_Armor_Helmet</li>
                    </requiredDefs>
                </requirement>
            </li>
            <li>
                <requirement>
                    <bodyPartGroupsMatchAny>
                        <li>Torso</li>
                    </bodyPartGroupsMatchAny>
                    <requiredDefs>
                        <li>FCP_Apparel_Enclave_Officer_Coat</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_Advanced_Power_Armor</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_Advanced_Power_Armor_MkII</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_X02_Tesla_Power_Armor</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_X02_Power_Armor</li>
                        <li MayRequire="Rick.FCP.PowerArmor">FCP_Apparel_Enclave_Hellfire_Power_Armor</li>
                    </requiredDefs>
                </requirement>
            </li>
        </roleApparelRequirements>
        <roleApparelRequirementCountCurve>
            <points>
                <li>(0, 2)</li>
                <li>(1, 2)</li>
            </points>
        </roleApparelRequirementCountCurve>
    </PreceptDef>

    <!-- Rank-and-file Officer -->

    <PreceptDef ParentName="PreceptRoleMultiBase">
        <defName>FCP_IdeoRole_Enclave_Officer</defName>
        <label>Officer</label>
        <description>Officers have proven themselves in enough engagements to command their own company, trusted with the Enclave's advanced weaponry and doctrine.</description>
        <iconPath>Things/UI/Roles/FCP_Enclave_Officer</iconPath>
        <roleRequirements>
            <li Class="RoleRequirement_MinSkillAny">
                <skills>
                    <Shooting>13</Shooting>
                </skills>
            </li>
        </roleRequirements>
        <roleRequiredWorkTags>
            <li>Violent</li>
        </roleRequiredWorkTags>
        <requiredMemes>
            <li>FCP_Meme_EnclaveManifestDestiny</li>
        </requiredMemes>
        <roleEffects>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>ShootingAccuracyPawn</statDef>
                <modifier>5</modifier>
            </li>
            <li Class="RoleEffect_PawnStatOffset">
                <statDef>SocialImpact</statDef>
                <modifier>0.08</modifier>
            </li>
        </roleEffects>
        <displayOrderInImpact>1</displayOrderInImpact>
    </PreceptDef>

</Defs>
